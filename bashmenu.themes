portman-2:
  background:
    enabled: true
    image: assets/wallpapers/portman-2.jpg
    opacity: 0.8500000238418579
    scaling: stretch
    clustering: 0
    quantization: 1
    mode: quarterblock
  divider:
    char: ─
    length: '{window_width}'
  indicator: '{nf:=:#f1bb}'
  marquee:
    char: •
    gap: 4
  toast:
    char: ▌
    timeout: 2.0
  window:
    border_horizontal: ─
    border_vertical: │
    border_top_left: ┌
    border_top_right: ┐
    border_bottom_left: └
    border_bottom_right: ┘
    left_tee: ├
    right_tee: ┤
    top_tee: ┬
    bottom_tee: ┴
