  background:
    enabled: true
    image: assets/wallpapers/canopy.jpg
    opacity: 0.8500000238418579
    scaling: stretch
    clustering: 0
    quantization: 1
    mode: quarterblock
  divider:
    char: ─
    length: '{window_width}'
  indicator: '{nf:>:#eee9:}'
  marquee:
    char: ' '
    gap: 4
  window:
    border_horizontal: ─
    border_vertical: │
    border_top_left: ┌
    border_top_right: ┐
    border_bottom_left: └
    border_bottom_right: ┘
    left_tee: ├
    right_tee: ┤
    top_tee: ┬
    bottom_tee: ┴
    title_left_cap: '['
    title_right_cap: ']'
    gutter_border: ─
    gutter_separator: │
    gutter_left_tee: ├
    gutter_right_tee: ┤
    gutter_top_tee: ┬
    gutter_bottom_tee: ┴
    shadow_char: ░
