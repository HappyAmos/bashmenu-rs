happysun:
  background:
    enabled: true
    image: assets/wallpapers/happysun.png
    opacity: 0.5
    scaling: stretch
    clustering: 64
    quantization: 16
    mode: quarterblock
  divider:
    char: ─
    length: '{window_width}'
  indicator: '{nf:@::}'
  marquee:
    char: •
    gap: 5
  window:
    border_horizontal: ─
    border_vertical: │
    border_top_left: ┌
    border_top_right: ┐
    border_bottom_left: └
    border_bottom_right: ┘
    left_tee: ├
    right_tee: ┤
    top_tee: ┬
    bottom_tee: ┴
    title_left_cap: '['
    title_right_cap: ']'
    gutter_border: ─
    gutter_separator: │
    gutter_left_tee: ├
    gutter_right_tee: ┤
    gutter_top_tee: ┬
    gutter_bottom_tee: ┴
    shadow_char: ░
