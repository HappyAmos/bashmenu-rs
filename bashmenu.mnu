version: 0.0.1
title: Bash Menu
items:
  - '{divider}':
  - BM Developer Shortcuts:
      type: submenu
      submenu:
        title: New submenu
        items:
          - Convert Image To BM Wallpaper [80x48]:
              type: command
              icon: '{nf::#f11e7}'
              command: convert "{file_picker:path:{bashmenu_dir}/assets/wallpapers}"
                -resize 80x48\! -blur 0x0.5 +dither -colors 16 -scale 480x360\! "{file_picker:stem}.pixel.png"
              prompt: 'Convert image to BM friendly wallpaper:'
              start_dir: ~/Pictures
              interactive: true
              quiet: false
              alt_buffer: true
          - Edit bashmenu.md [{bashmenu_dir}/bashmenu.md]:
              type: editor
              file: '{bashmenu_dir}/bashmenu.md'
              tabstop: 4
              interactive: true
              quiet: false
              alt_buffer: true
              icon: '{nf::#f11e7}'
          - Edit DONE.md:
              type: editor
              icon: '{nf:\:#ec46}'
              file: '{bashmenu_dir}/.agents/skills/bashmenu-rs-developer/DONE.md'
              tabstop: 4
              interactive: true
              quiet: false
              alt_buffer: true
          - Edit README.md:
              type: editor
              icon: '{nf::#f1781}'
              tabstop: 4
              interactive: true
              quiet: false
              alt_buffer: true
              file: '{bashmenu_dir}/README.md'
          - Edit SKILL.md:
              type: editor
              file: '{bashmenu_dir}/.agents/skills/bashmenu-rs-developer/SKILL.md'
              tabstop: 4
              interactive: true
              quiet: false
              alt_buffer: true
              icon: '{nf::#f11e7}'
          - Edit TODO.md:
              type: editor
              icon: '{nf::#f11e7}'
              tabstop: 4
              interactive: true
              quiet: false
              alt_buffer: true
              file: '{bashmenu_dir}/.agents/skills/bashmenu-rs-developer/TODO.md'
          - Toast Test:
              type: script
              script: '{toast:2:"Hello, world. {date_time_24_short} Using theme: {theme}"}'
              interactive: true
              quiet: false
              alt_buffer: true
              icon: '{nf:t:#f0669}'
      interactive: true
      quiet: false
      alt_buffer: true
      icon: '{nf:/:#f14d3}'
      action: BM Developer Shortcuts
  - Notes [{notebooks_dir}/notes.yml]:
      type: notebook
      file: '{notebooks_dir}/notes.yml'
      interactive: true
      quiet: false
      alt_buffer: true
      icon: '{nf:/:#f1a7c}'
      action: '{notebooks_dir}/notes.yml'
  - '{divider}':
  - Applications:
      icon: '{nf::#f003b:}'
      submenu:
        title: Applications
        items:
          - '{divider}':
          - Antigravity [Resume Last Session]:
              icon: '{nf::#eb44:}'
              type: command
              action: cd {dir_picker_new} && agy
              interactive: true
              quiet: true
              alt_buffer: true
          - Brow6el:
              type: script
              action: '{home}/github/brow6el/build/brow6el'
              icon: '{nf::#f059f:}'
              interactive: true
              quiet: true
          - Built-In Text Editor:
              icon: '{nf::#f11e7}'
              type: editor
              show_whitespace: true
              tabstop: 4
          - Copilot:
              icon: '{nf::#F0372}'
              type: command
              action: cd {dir_picker_new} && copilot
              interactive: true
              quiet: true
              alt_buffer: true
          - Carbonyl [https://duckduckgo.com]:
              type: command
              action: carbonyl https://duckduckgo.com
              icon: '{nf::#f059f:}'
              interactive: true
              quiet: true
          - Gemini [Resume Last Session]:
              icon: '{nf::#F1A0}'
              type: command
              action: cd {dir_picker_new} && gemini --resume latest
              interactive: true
              quiet: true
              alt_buffer: true
          - Glow:
              type: command
              action: glow -t {home}/cheat
              interactive: true
              quiet: true
              icon: '{nf::#eeab:}'
              alt_buffer: true
          - Internet:
              type: submenu
              submenu:
                title: New submenu
                items: []
              interactive: true
              quiet: false
              alt_buffer: true
              icon: '{nf::#f059f}'
          - Midnight Commander:
              icon: '{nf::#f0ab6}'
              type: script
              action: /usr/bin/mc
              interactive: true
              quiet: true
          - Open Code:
              type: command
              icon: '{nf::#f4b0}'
              command: cd {dir_picker_new} && opencode
              interactive: true
              quiet: false
              alt_buffer: true
          - Search Nerd Font & Emoji [{scripts_dir}/glyphs.sh]:
              type: script
              action: '{scripts_dir}/glyphs.sh {param}'
              stream: true
              icon: '{nf::#f422}'
          - Unicode Block Explorer:
              type: script
              action: '{scripts_dir}/unicode.sh'
              icon: '{nf::#f0ed0:}'
              interactive: true
              quiet: true
          - View ASCII Symbols [Standard and Extended]:
              type: script
              action: '{scripts_dir}/rich.sh {bashmenu_dir}/assets/ascii.md'
              icon: '{nf::#f07ef:}'
              stream: true
              quiet: true
          - View Colors:
              type: script
              action: '{scripts_dir}/ncurses_colors.py'
              icon: '{nf::#f0301:}'
              stream: true
              quiet: true
              external: true
          - Vim:
              icon: '{nf::#e62b}'
              type: command
              action: vim
              interactive: true
              quiet: true
          - '{divider}':
          - Back to Main Menu:
              icon: '{nf::#f048}'
              type: back
              interactive: true
              quiet: false
              alt_buffer: true
          - '{divider}':
      type: submenu
      interactive: true
      quiet: false
      alt_buffer: true
  - Experiments:
      type: submenu
      submenu:
        title: New submenu
        items:
          - '{divider}':
          - Discover New proot Containers:
              type: script
              script: '{scripts_dir}/webopen.sh https://hub.docker.com/categories/operating-systems'
              interactive: true
              quiet: true
              alt_buffer: true
          - Install proot-distro Container:
              type: command
              command: proot-distro install {param}
              prompt: 'Name of the proot-distro to install [name:tag]:'
              stream: true
              interactive: false
              quiet: true
              alt_buffer: true
          - "List Installed proot-distro's":
              type: command
              command: proot-distro list
              stream: true
              interactive: false
              quiet: true
              alt_buffer: true
          - Remove Installed proot-distro:
              type: command
              command: proot-distro remove {param}
              prompt: 'Name of proot-distro to remove:'
              stream: true
              interactive: false
              quiet: true
              alt_buffer: true
          - Run proot-distro Container:
              type: command
              command: proot-distro login {param}
              interactive: true
              quiet: true
              alt_buffer: true
              prompt: 'Name of the proot-distro to run:'
          - '{divider}':
          - Back To Main Menu:
              type: back
              interactive: true
              quiet: false
              alt_buffer: true
              icon: '{nf::#f048}'
          - '{divider}':
      action: Experiments
      interactive: true
      quiet: false
      icon: '{nf::#f0668}'
  - Games:
      submenu:
        title: Games
        items:
          - '{divider}':
          - BSD Games:
              type: script
              action: '{scripts_dir}/bsdgames.sh'
              icon: '{nf::#f30c:}'
              interactive: true
              quiet: true
          - Console Games:
              type: command
              action: '{scripts_dir}/games.sh'
              icon: '{nf::#f11b:}'
              interactive: true
              quiet: true
          - Space:
              type: command
              command: /home/andrew/github/spacetrader/spacetrader
              interactive: true
              quiet: true
              alt_buffer: true
              icon: '{nf::#f197}'
          - QBasic Gorillas Clone:
              type: script
              action: python3 {scripts_dir}/gorillas.py
              icon: '{nf::#f1e2:}'
              interactive: true
              quiet: true
          - '{divider}':
          - Back to Main Menu:
              type: back
              icon: '{nf::#f048}'
              interactive: true
              quiet: false
              alt_buffer: true
          - '{divider}':
      icon: '{nf::#f003b:}'
      type: submenu
      interactive: true
      quiet: false
      alt_buffer: true
  - Install:
      icon: '{nf::#f01da:}'
      submenu:
        title: Install Tools Menu
        items:
          - '{divider}':
          - Apt update && upgrade:
              type: script
              action: '{scripts_dir}/system_update.sh'
              interactive: true
              quiet: true
              icon: '{nf::#f487}'
          - Install autoexec.sh Launcher:
              type: inject_block
              template: '{templates_dir}/autoexec.sh.tmpl'
              target: ~/.bashrc
              block_id: launch_autoexec
              icon: '{nf::#ead3}'
          - Install bash_aliases From Template:
              type: inject_block
              template: '{templates_dir}/bash_aliases.tmpl'
              target: ~/.bash_aliases
              block_id: bash_aliases
              icon: '{nf::#eeb6}'
          - Install Basics [vim mc htop glow gum curl wget git shellcheck shfmt jq yq]:
              type: submenu
              action: '{scripts_dir}/install_basics.sh'
              stream: true
              icon: '{nf::#ed5b}'
              submenu:
                title: Install Basics [vim mc htop glow gum curl wget git shellcheck
                  shfmt jq yq]
                items: []
          - Install Brow6el [https://tangled.org/janantos.tngl.sh/brow6el/raw/main/download_cef.sh]:
              type: command
              action: bash -c "$(curl -fsSL https://tangled.org/janantos.tngl.sh/brow6el/raw/main/download_cef.sh)"
              icon: '{nf::#f059f:}'
              interactive: true
          - Install Cheatsheets From Private Repo [https://github.com/HappyAmos/cheat.git]:
              type: script
              action: '{scripts_dir}/install_cheat.sh'
              stream: true
              icon: '{nf::#f02aa}'
          - Install Kitty [curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin]:
              type: command
              action: curl -fsSL https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin
              icon: '{nf::#f26b:}'
              interactive: true
              quiet: true
          - Install Games [{scripts_dir}/install_games.sh]:
              type: script
              action: '{scripts_dir}/install_games.sh'
              icon: '{nf::#f11b:}'
              external: true
              interactive: true
          - Install kmscon [{scripts_dir}/install_kmscon.sh]:
              type: script
              action: '{scripts_dir}/install_kmscon.sh'
              stream: true
              icon: '{nf::#f0e51}'
          - Install Nerd Fonts [curl https://raw.githubusercontent.com/officialrajdeepsingh/nerd-fonts-installer/main/install.sh]:
              type: command
              action: bash -c "$(curl -fsSL https://raw.githubusercontent.com/officialrajdeepsingh/nerd-fonts-installer/main/install.sh)"
              icon: '{nf::#eb54:}'
              interactive: true
          - Install Scripts From Private Repo [https://github.com/HappyAmos/scripts.git]:
              type: script
              action: '{scripts_dir}/install_scripts.sh'
              stream: true
              icon: '{nf::#ee79}'
          - '{divider}':
          - Back to Main Menu:
              type: back
              icon: '{nf::#f048}'
          - '{divider}':
      type: submenu
      interactive: true
      quiet: false
      alt_buffer: true
  - Internet:
      type: submenu
      icon: '{nf::#f059f:}'
      submenu:
        title: Internet Options
        items:
          - '{divider}':
          - Bookmarks:
              type: submenu
              submenu:
                title: New submenu
                items:
                  - Rust Book:
                      type: command
                      icon: '{nf::#f02d}'
                      command: '{scripts_dir}/webopen.sh https://doc.rust-lang.org/rust-by-example/hello/print.html'
                      interactive: true
                      quiet: false
                      alt_buffer: true
              icon: '{nf::#f461}'
              interactive: true
              quiet: false
              alt_buffer: true
          - Github.com:
              type: command
              command: '{scripts_dir}/webopen.sh https://github.com'
              interactive: true
              quiet: false
              alt_buffer: true
              icon: '{nf::#ea84}'
          - Google.com:
              type: script
              script: '{scripts_dir}/webopen.sh https://google.com'
              interactive: true
              quiet: false
              alt_buffer: true
              icon: '{nf::#f02ad}'
          - Launch GUI Web Browser [{scripts_dir}/webopen.sh --gui]:
              type: command
              action: '{scripts_dir}/webopen.sh --gui'
              icon: '{nf::#f268:}'
              interactive: true
              quiet: true
              alt_buffer: true
          - Launch Terminal Web Browser [{scripts_dir}/webopen.sh --tty]:
              type: command
              action: '{scripts_dir}/webopen.sh --tty'
              icon: '{nf::#f120:}'
              interactive: true
              quiet: true
              alt_buffer: true
          - '{divider}':
          - Back to Main Menu:
              type: back
              icon: '{nf::#f048}'
          - '{divider}':
      interactive: true
      quiet: false
      alt_buffer: true
  - Network Utilities:
      icon: '{nf::#ef09:}'
      submenu:
        title: Network Utilities Options
        items:
          - '{divider}':
          - Configure DNS servers [dnsconfig.sh]:
              type: script
              action: '{scripts_dir}/dnsconfig.sh {settings.dns.ipv4.primary} {settings.dns.ipv4.secondary}
                {settings.dns.ipv6.primary} {settings.dns.ipv6.secondary}'
              stream: true
              icon: '{nf::#f0b8c}'
          - Configure Ping Target [{settings.ping_target}]:
              type: config
              key: settings.ping_target
              title: Edit Ping Target
              prompt: 'Enter Hostname or IP Address:'
              icon: '{nf::#f11ab}'
          - IP Information:
              type: script
              action: '{scripts_dir}/ip_info.sh'
              icon: '{nf::#F0A5F:}'
              interactive: false
              stream: true
          - Ping Target [{settings.ping_target}]:
              type: confirm
              title: Confirm Ping Task
              message: Start pinging target host {settings.ping_target}?
              on_yes:
                type: command
                action: '{scripts_dir}/ping.sh {settings.ping_target}'
                stream: true
              on_no:
                type: message
                title: Task Cancelled
                message: Ping request was cancelled by user.
              icon: '{nf::#f11ab}'
              prompt: Start pinging target host {settings.ping_target}?
              interactive: true
              quiet: false
              alt_buffer: true
          - Show Configured DNS [getdns.py]:
              type: script
              action: '{scripts_dir}/getdns.py'
              stream: true
              icon: '{nf::#f01d6}'
          - Show Hostname Information [{scripts_dir}/hostname.sh]:
              type: script
              action: '{scripts_dir}/hostname.sh'
              stream: true
              icon: '{nf::#f08ad}'
          - Show Network Interfaces [ip a]:
              type: command
              action: ip a
              icon: '{nf::#ef09}'
              stream: true
              interactive: false
              quiet: true
          - '{divider}':
          - Back to Main Menu:
              type: back
              icon: '{nf::#f048}'
          - '{divider}':
      type: submenu
      interactive: true
      quiet: false
      alt_buffer: true
  - Options & Settings:
      icon: '{nf::#f423:}'
      submenu:
        title: Options & Settings
        items:
          - '{divider}':
          - '[b]Bashmenu Settings[/b]':
              type: submenu
              submenu:
                title: Bashmenu Settings
                items:
                  - '{divider}':
                  - Change Theme:
                      type: theme_selector
                      icon: '{nf::#f03d8}'
                  - Theme Editor [themeedit]:
                      type: script
                      action: themeedit
                      icon: '{nf::#f0426}'
                      interactive: true
                      quiet: true
                      refresh: true
                  - Edit Configuration File [{bashmenu_dir}/bashmenu.yml]:
                      type: editor
                      action: '{bashmenu_dir}/bashmenu.yml'
                      icon: '{nf::#f1de}'
                      show_whitespace: true
                      tabstop: 4
                      interactive: true
                      quiet: false
                      alt_buffer: true
                  - Edit Menu Layout [{bashmenu_dir}/bashmenu.mnu]:
                      type: editor
                      action: '{bashmenu_dir}/bashmenu.mnu'
                      icon: '{nf::#f0279}'
                      show_whitespace: true
                      tabstop: 4
                      interactive: true
                      quiet: false
                      alt_buffer: true
                  - Edit Scripts [{scripts_dir}]:
                      type: editor
                      action: '{scripts_dir}/{file_picker_new}'
                      icon: '{nf::#eae9}'
                      file: '{file_picker_new}'
                      start_dir: '{scripts_dir}'
                      tabstop: 4
                      interactive: true
                      quiet: false
                      alt_buffer: true
                  - Edit Templates [{templates_dir}]:
                      type: editor
                      action: '{templates_dir}/{file_picker}'
                      icon: '{nf::#f09ee}'
                      show_whitespace: true
                      file: '{file_picker}'
                      start_dir: '{templates_dir}'
                      tabstop: 4
                      interactive: true
                      quiet: false
                      alt_buffer: true
                  - Edit Themes File [bashmenu.themes]:
                      type: editor
                      action: bashmenu.themes
                      icon: '{nf::#e22b}'
                      file: '{bashmenu_dir}/bashmenu.themes'
                      tabstop: 4
                      interactive: true
                      quiet: false
                      alt_buffer: true
                  - Enable Automatic Updates (git pull) [{settings.check_for_updates}]:
                      type: toggle
                      key: settings.check_for_updates
                      title: Toggle Auto Update
                      message: Enable automatic updates?
                      icon: '{nf::#ea77}'
                  - Enable Nerd Fonts [{settings.use_nerd_fonts}]:
                      type: toggle
                      key: settings.use_nerd_fonts
                      title: Toggle Nerd Fonts
                      message: Enable colorful menu emojis and Nerd Fonts?
                      icon: '{nf::#f031}'
                  - Nerd Font Display Width [{settings.nerd_font_width}]:
                      type: config
                      key: settings.nerd_font_width
                      title: Configure Nerd Font Glyph Width
                      prompt: 'Enter Nerd Font character width mode (auto, 1, 2):'
                      icon: '{nf::#f07e}'
                  - Editor Tab to Spaces Mode [{settings.tab_to_spaces}]:
                      type: toggle
                      key: settings.tab_to_spaces
                      title: Configure Tab Mode
                      prompt: 'Convert TAB key to spaces? (true/false):'
                      icon: '{nf::#ec3c}'
                  - Editor Tabstop Distance [{settings.tabstop}]:
                      type: config
                      key: settings.tabstop
                      title: Configure Tabstop Distance
                      prompt: 'Enter tabstop distance (spaces per TAB press):'
                      icon: '{nf::#ee10}'
                  - Pager Text Editor [{settings.pager_editor}]:
                      type: radio
                      key: settings.pager_editor
                      title: Pager Text Editor [{settings.pager_editor}]
                      prompt: 'Select editor launched when pressing [e] in pager:'
                      options:
                        - label: Default System Editor ($EDITOR)
                          value: default
                        - label: Built-in Editor (BashEdit)
                          value: builtin
                        - label: Vim
                          value: vim
                      icon: '{nf::#f044}'
                      action: settings.pager_editor
                      interactive: true
                      quiet: false
                      alt_buffer: true
                  - Configure Status Gutter [{settings.status_gutter}]:
                      type: config
                      key: settings.status_gutter
                      title: Configure Status Gutter
                      prompt: 'Enter status gutter format. Available options: {user},
                        {battery}, {date}, {date_time_24}, {date_time_24_short}, {date_time_12},
                        {date_time_12_short}, {host}, {user-mode}, {version}, {utc_seconds}'
                      icon: '{nf::#ebf3}'
                  - Status Gutter Refresh Rate [[{app.settings.refresh_interval}] seconds]:
                      type: config
                      icon: '{nf:@:#f1452}'
                      key: app.settings.refresh_interval
                      prompt: 'Seconds until next status gutter refresh:'
                      interactive: true
                      quiet: false
                      alt_buffer: true
                  - Visual Menu Editor [menuedit]:
                      type: script
                      action: menuedit
                      icon: '{nf::#f044}'
                      interactive: true
                      quiet: true
                      refresh: true
                  - '{divider}':
                  - Back to Options & Settings:
                      type: back
                      icon: '{nf::#f048}'
                  - '{divider}':
              icon: '{nf::#f013}'
          - Edit autoexec.sh [{home}/autoexec.sh]:
              type: editor
              action: '{home}/autoexec.sh'
              icon: '{nf::#f11e7}'
          - Edit .bashrc [{bashrc}]:
              type: editor
              action: '{bashrc}'
              show_whitespace: true
              icon: '{nf::#f11e7}'
          - Edit .bash_aliases [{bash_aliases}]:
              type: editor
              action: '{bash_aliases}'
              show_whitespace: true
              icon: '{nf::#f11e7}'
          - Edit .vimrc [{vimrc}]:
              type: editor
              action: '{vimrc}'
              tabstop: 4
              icon: '{nf::#f11e7}'
          - '{divider}':
          - Back to Main Menu:
              type: back
              icon: '{nf::#f048}'
          - '{divider}':
      type: submenu
      interactive: true
      quiet: false
      alt_buffer: true
  - System Information:
      icon: '{nf::#e66a:}'
      submenu:
        title: System Information Options
        items:
          - '{divider}':
          - Check Disk Usage [df -h]:
              type: command
              action: df -h 2>/dev/null
              icon: '{nf::#f02ca:}'
              stream: true
              quiet: false
              interactive: false
          - Check RAM Usage [free -h]:
              type: command
              action: free -h
              icon: '{nf::#f035b:}'
              stream: true
              quiet: false
              interactive: false
          - Check USB Controller [lsusb -vt]:
              type: command
              action: lsusb -vt
              stream: true
              quiet: false
              icon: '{nf::#f287:}'
              interactive: false
          - Display Block Devices [lsblk]:
              type: command
              action: lsblk
              icon: '{nf::#f233:}'
              stream: true
              quiet: false
              interactive: false
          - Display CPU Information [lscpu]:
              type: command
              action: lscpu
              quiet: false
              stream: true
              icon: '{nf::#f2db:}'
              interactive: false
          - Display PCI Devices and Drivers [lspci -k]:
              type: command
              action: lspci -k
              quiet: false
              stream: true
              icon: '{nf::#f08ae:}'
              interactive: false
          - Kernel Information [uname -r]:
              type: command
              action: uname -r
              icon: '{nf::#f31a:}'
              stream: true
              quiet: true
          - Which [which [param]]:
              type: command
              action: which {param}
              stream: true
              quiet: true
              icon: '{nf::#f002:}'
          - '{divider}':
          - Back to Main Menu:
              type: back
              icon: '{nf::#f048}'
          - '{divider}':
      type: submenu
      interactive: true
      quiet: false
      alt_buffer: true
  - Weather:
      submenu:
        title: Weather
        items:
          - '{divider}':
          - Weather Location [{user.postal_code}]:
              type: config
              action: user.postal_code
              icon: '{nf::#eef0:}'
              interactive: false
              stream: true
              quiet: true
              key: user.postal_code
              title: Weather Location [{user.postal_code}]
              prompt: 'Enter your postal code/zip code:'
              picker: none
          - Weather -> 3 Day [curl wttr.in/{user.postal_code}]:
              type: command
              action: curl -s wttr.in/{user.postal_code} | {scripts_dir}/pager.sh
              icon: '{nf::#eef0:}'
              quiet: true
              interactive: true
              alt_buffer: true
          - Weather -> 3 Day v.2. [curl v2.wttr.in/{user.postal_code}]:
              type: command
              action: curl -s v2.wttr.in/{user.postal_code} | {scripts_dir}/pager.sh
              icon: '{nf::#eef0:}'
              interactive: true
              quiet: true
              alt_buffer: true
          - '{divider}':
          - Back to Main Menu:
              type: back
              icon: '{nf::#f048:}'
          - '{divider}':
      icon: '{nf::#eef0:}'
      type: submenu
      interactive: true
      quiet: false
      alt_buffer: true
  - '{divider}':
  - Help [rich.sh bashmenu.md]:
      icon: '{nf::#f02d6:}'
      type: command
      action: '{scripts_dir}/rich.sh {bashmenu_dir}/bashmenu.md'
      interactive: true
      quiet: true
      alt_buffer: true
  - Exit Menu:
      icon: '{nf::#f0a48:}'
      type: exit
      interactive: true
      quiet: false
      alt_buffer: true
  - '{divider}':
