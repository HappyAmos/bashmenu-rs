version: '0.0.1'
title: Bash Menu
items:
- '{divider}': null
- Notes [{notebooks_dir}/notes.yml]:
    type: notebook
    icon: '{nf:/:#f1a7c}'
    action: '{notebooks_dir}/notes.yml'
    file: '{notebooks_dir}/notes.yml'
    interactive: true
    quiet: false
    alt_buffer: true
- '{divider}': null
- Applications:
    type: submenu
    icon: '{nf::#f003b:}'
    interactive: true
    quiet: false
    alt_buffer: true
    submenu:
      title: Applications
      items:
      - '{divider}': null
      - Midnight Commander:
          type: script
          icon: '{nf::#f0ab6}'
          action: /usr/bin/mc
          interactive: true
          quiet: true
      - Search Nerd Font & Emoji [{scripts_dir}/glyphs.sh]:
          type: script
          icon: '{nf::#f422}'
          action: '{scripts_dir}/glyphs.sh {param}'
          prompt: 'Enter search term:'
          window_percent: 75
          stream: true
      - Unicode Block Explorer:
          type: script
          icon: '{nf::#f0ed0:}'
          action: '{scripts_dir}/unicode.sh'
          interactive: true
          quiet: true
      - Vim:
          type: command
          icon: '{nf::#e62b}'
          action: vim
          interactive: true
          quiet: true
      - '{divider}': null
      - Back to Main Menu:
          type: back
          icon: '{nf::#f048}'
          interactive: true
          quiet: false
          alt_buffer: true
      - '{divider}': null
- Experiments:
    type: submenu
    icon: '{nf::#f0668}'
    action: Experiments
    interactive: true
    quiet: false
    submenu:
      title: New submenu
      items:
      - '{divider}': null
      - Discover New proot Containers:
          type: script
          script: '{scripts_dir}/webopen.sh https://hub.docker.com/categories/operating-systems'
          interactive: true
          quiet: true
          alt_buffer: true
      - Install proot-distro Container:
          type: command
          command: proot-distro install {param}
          prompt: 'Name of the proot-distro to install [name:tag]:'
          interactive: false
          quiet: true
          alt_buffer: true
          stream: true
      - List Installed proot-distro's:
          type: command
          command: proot-distro list
          interactive: false
          quiet: true
          alt_buffer: true
          stream: true
      - Remove Installed proot-distro:
          type: command
          command: proot-distro remove {param}
          prompt: 'Name of proot-distro to remove:'
          interactive: false
          quiet: true
          alt_buffer: true
          stream: true
      - Run proot-distro Container:
          type: command
          command: proot-distro login {param}
          prompt: 'Name of the proot-distro to run:'
          interactive: true
          quiet: true
          alt_buffer: true
      - '{divider}': null
      - Back To Main Menu:
          type: back
          icon: '{nf::#f048}'
          interactive: true
          quiet: false
          alt_buffer: true
      - '{divider}': null
- Games:
    type: submenu
    icon: '{nf::#f003b:}'
    interactive: true
    quiet: false
    alt_buffer: true
    submenu:
      title: Games
      items:
      - '{divider}': null
      - BSD Games:
          type: script
          icon: '{nf::#f30c:}'
          action: '{scripts_dir}/bsdgames.sh'
          interactive: true
          quiet: true
      - Console Games:
          type: command
          icon: '{nf::#f11b:}'
          action: '{scripts_dir}/games.sh'
          interactive: true
          quiet: true
      - '{divider}': null
      - Back to Main Menu:
          type: back
          icon: '{nf::#f048}'
          interactive: true
          quiet: false
          alt_buffer: true
      - '{divider}': null
- Install:
    type: submenu
    icon: '{nf::#f01da:}'
    interactive: true
    quiet: false
    alt_buffer: true
    submenu:
      title: Install Tools Menu
      items:
      - '{divider}': null
      - Apt update && upgrade:
          type: script
          icon: '{nf::#f487}'
          action: '{scripts_dir}/system_update.sh'
          interactive: true
          quiet: true
      - Install autoexec.sh Launcher:
          type: inject_block
          icon: '{nf::#ead3}'
          template: '{templates_dir}/autoexec.sh.tmpl'
          target: ~/.bashrc
          block_id: launch_autoexec
      - Install bash_aliases From Template:
          type: inject_block
          icon: '{nf::#eeb6}'
          block_id: bash_aliases
          template: '{templates_dir}/bash_aliases.tmpl'
          target: ~/.bash_aliases
      - Install Basics [vim mc htop glow gum curl wget git shellcheck shfmt jq yq sc cmatrix]:
          type: submenu
          icon: '{nf::#ed5b}'
          action: '{scripts_dir}/install_basics.sh'
          interactive: false
          quiet: true
          tabstop: 4
          submenu:
            title: Install Basics [vim mc htop glow gum curl wget git shellcheck shfmt jq yq]
            items: []
          stream: true
          no_formatting: false
          exec_mode: streaming
          external: false
          refresh: false
          show_whitespace: false
          window_percent: 65
          masked: false
      - Install Cheatsheets From Private Repo [https://github.com/HappyAmos/cheat.git]:
          type: script
          icon: '{nf::#f02aa}'
          action: '{scripts_dir}/install_cheat.sh'
          stream: true
      - Install Games [{scripts_dir}/install_games.sh]:
          type: script
          icon: '{nf::#f11b:}'
          action: '{scripts_dir}/install_games.sh'
          interactive: true
          external: true
      - Install KCChase and CMatrix Terminal Screensavers:
          type: command
          interactive: true
          quiet: false
          alt_buffer: true
          tabstop: 4
          refresh: false
          show_whitespace: false
          exec_mode: console
          no_formatting: false
          external: false
          stream: false
          masked: false
      - Install Nerd Fonts [curl https://raw.githubusercontent.com/officialrajdeepsingh/nerd-fonts-installer/main/install.sh]:
          type: command
          icon: '{nf::#eb54:}'
          action: bash -c "$(curl -fsSL https://raw.githubusercontent.com/officialrajdeepsingh/nerd-fonts-installer/main/install.sh)"
          interactive: true
      - '{divider}': null
      - Back to Main Menu:
          type: back
          icon: '{nf::#f048}'
      - '{divider}': null
- Internet:
    type: submenu
    icon: '{nf::#f059f:}'
    interactive: true
    quiet: false
    alt_buffer: true
    submenu:
      title: Internet Options
      items:
      - '{divider}': null
      - Bookmarks:
          type: submenu
          icon: '{nf::#f461}'
          interactive: true
          quiet: false
          alt_buffer: true
          submenu:
            title: New submenu
            items:
            - '{divider}': null
            - Rust Book:
                type: command
                icon: '{nf::#f02d}'
                command: '{scripts_dir}/webopen.sh https://doc.rust-lang.org/rust-by-example/hello/print.html'
                interactive: true
                quiet: false
                alt_buffer: true
            - Github.com:
                type: command
                icon: '{nf::#ea84}'
                command: '{scripts_dir}/webopen.sh https://github.com'
                interactive: true
                quiet: false
                alt_buffer: true
            - Google.com:
                type: script
                icon: '{nf::#f02ad}'
                script: '{scripts_dir}/webopen.sh https://google.com'
                interactive: true
                quiet: false
                alt_buffer: true
            - Textfiles (VT100 Art And Animations):
                type: script
                icon: '{nf::#ea85}'
                action: '{scripts_dir}/webopen.sh http://artscene.textfiles.com/vt100/'
                script: '{scripts_dir}/webopen.sh http://artscene.textfiles.com/vt100/'
                start_dir: '{script_dir}'
                interactive: true
                quiet: true
                alt_buffer: true
                tabstop: 4
                external: true
                masked: false
                exec_mode: console
                stream: false
                no_formatting: false
                show_whitespace: false
                refresh: false
            - '{divider}': null
            - Back:
                type: back
                icon: '{nf::#f048}'
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
                external: false
                refresh: false
                exec_mode: console
                no_formatting: false
                stream: false
                masked: false
                show_whitespace: false
            - '{divider}': null
      - Launch GUI Web Browser [{scripts_dir}/webopen.sh --gui]:
          type: command
          icon: '{nf::#f268:}'
          action: '{scripts_dir}/webopen.sh --gui'
          interactive: true
          quiet: true
          alt_buffer: true
      - Launch Terminal Web Browser [{scripts_dir}/webopen.sh --tty]:
          type: command
          icon: '{nf::#f120:}'
          action: '{scripts_dir}/webopen.sh --tty'
          interactive: true
          quiet: true
          alt_buffer: true
      - '{divider}': null
      - Back to Main Menu:
          type: back
          icon: '{nf::#f048}'
      - '{divider}': null
- Media:
    type: submenu
    icon: '{nf::#f52c}'
    interactive: true
    quiet: false
    alt_buffer: true
    tabstop: 4
    submenu:
      title: New submenu
      items:
      - '{divider}': null
      - Play VT Animation File [{curl -s [URL] | pv -q -L 2000}]:
          type: command
          icon: '{nf::#f52c}'
          command: curl -s {param} | pv -q -L 2000
          action: curl -s {param} | pv -q -L 2000
          prompt: 'URL Of VT File:'
          interactive: true
          quiet: false
          alt_buffer: true
          tabstop: 4
          show_whitespace: false
          no_formatting: false
          stream: false
          external: false
          masked: false
          refresh: false
          exec_mode: console
      - '{divider}': null
      - Back To Main Menu:
          type: back
          interactive: true
          quiet: false
          alt_buffer: true
          tabstop: 4
          show_whitespace: false
          exec_mode: console
          stream: false
          no_formatting: false
          external: false
          refresh: false
          masked: false
      - '{divider}': null
    external: false
    exec_mode: console
    masked: false
    stream: false
    show_whitespace: false
    no_formatting: false
    refresh: false
- Network Utilities:
    type: submenu
    icon: '{nf::#ef09:}'
    interactive: true
    quiet: false
    alt_buffer: true
    submenu:
      title: Network Utilities Options
      items:
      - '{divider}': null
      - Configure DNS servers [dnsconfig.sh]:
          type: script
          icon: '{nf::#f0b8c}'
          action: '{scripts_dir}/dnsconfig.sh {settings.dns.ipv4.primary} {settings.dns.ipv4.secondary} {settings.dns.ipv6.primary} {settings.dns.ipv6.secondary}'
          stream: true
      - Configure Ping Target [{settings.ping_target}]:
          type: config
          icon: '{nf::#f11ab}'
          prompt: 'Enter Hostname or IP Address:'
          key: settings.ping_target
          title: Edit Ping Target
      - IP Information:
          type: script
          icon: '{nf::#F0A5F:}'
          action: '{scripts_dir}/ip_info.sh'
          interactive: false
          stream: true
      - Ping Target [{settings.ping_target}]:
          type: confirm
          icon: '{nf::#f11ab}'
          prompt: Start pinging target host {settings.ping_target}?
          interactive: true
          quiet: false
          alt_buffer: true
          on_yes:
            type: command
            action: '{scripts_dir}/ping.sh {settings.ping_target}'
            stream: true
          on_no:
            type: message
            title: Task Cancelled
            message: Ping request was cancelled by user.
          message: Start pinging target host {settings.ping_target}?
          title: Confirm Ping Task
      - Show Configured DNS [getdns.py]:
          type: script
          icon: '{nf::#f01d6}'
          action: '{scripts_dir}/getdns.py'
          stream: true
      - Show Hostname Information [{scripts_dir}/hostname.sh]:
          type: script
          icon: '{nf::#f08ad}'
          action: '{scripts_dir}/hostname.sh'
          stream: true
      - Show Network Interfaces [ip a]:
          type: command
          icon: '{nf::#ef09}'
          action: ip a
          interactive: false
          quiet: true
          stream: true
      - '{divider}': null
      - Back to Main Menu:
          type: back
          icon: '{nf::#f048}'
      - '{divider}': null
- Options & Settings:
    type: submenu
    icon: '{nf::#f423:}'
    interactive: true
    quiet: false
    alt_buffer: true
    submenu:
      title: Options & Settings
      items:
      - '{divider}': null
      - '[b]Bashmenu Settings[/b]':
          type: submenu
          icon: '{nf::#f013}'
          submenu:
            title: Bashmenu Settings
            items:
            - '{divider}': null
            - Configure Status Gutter [{settings.status_gutter}]:
                type: config
                icon: '{nf::#ebf3}'
                prompt: 'Enter status gutter format. Available options: {user}, {battery}, {date}, {date_time_24}, {date_time_24_short}, {date_time_12}, {date_time_12_short}, {host}, {user-mode}, {version}, {utc_seconds}'
                title: Configure Status Gutter
                key: settings.status_gutter
            - Edit Shortcuts File [{shortcuts_file}]:
                type: editor
                icon: '{nf::#f11c}'
                action: '{shortcuts_file}'
                file: '{shortcuts_file}'
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
            - Edit Configuration File [{bashmenu_dir}/bashmenu.yml]:
                type: editor
                icon: '{nf::#f1de}'
                action: '{bashmenu_dir}/bashmenu.yml'
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
                show_whitespace: true
            - Edit Menu Layout [{bashmenu_dir}/bashmenu.mnu]:
                type: editor
                icon: '{nf::#f0279}'
                action: '{bashmenu_dir}/bashmenu.mnu'
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
                show_whitespace: true
            - Edit Screensaver Delay [{app.settings.inactivity_timeout.milliseconds}]:
                type: config
                icon: '{nf::#f093a}'
                action: app.settings.inactivity_timeout.milliseconds
                prompt: Number of milliseconds before screensaver runs
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
                show_whitespace: false
                no_formatting: false
                masked: false
                key: app.settings.inactivity_timeout.milliseconds
                external: false
                refresh: false
                exec_mode: console
                stream: false
            - Edit Screensaver Program [{app.settings.inactivity_timeout.command}]:
                type: config
                icon: '{nf::#f093a}'
                action: app.settings.inactivity_timeout.command
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
                exec_mode: console
                key: app.settings.inactivity_timeout.command
                external: false
                show_whitespace: false
                refresh: false
                no_formatting: false
                masked: false
                stream: false
            - Test Configured Screen Saver [{app.settings.inactivity_timeout.command}]:
                type: command
                icon: '{nf::#f093a}'
                command: '{app.settings.inactivity_timeout.command}'
                action: '{app.settings.inactivity_timeout.command}'
                interactive: true
                quiet: true
                alt_buffer: true
                tabstop: 4
                show_whitespace: false
                no_formatting: false
                exec_mode: console
                refresh: false
                stream: false
                external: false
                masked: false
            - Edit Scripts [{scripts_dir}]:
                type: editor
                icon: '{nf::#eae9}'
                action: '{scripts_dir}/{file_picker_new}'
                file: '{file_picker_new}'
                start_dir: '{scripts_dir}'
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
            - Edit Templates [{templates_dir}]:
                type: editor
                icon: '{nf::#f09ee}'
                action: '{templates_dir}/{file_picker}'
                file: '{file_picker}'
                start_dir: '{templates_dir}'
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
                show_whitespace: true
            - Edit Themes File [{bashmenu_dir}/bashmenu.themes]:
                type: editor
                icon: '{nf::#e22b}'
                action: '{bashmenu_dir}/bashmenu.themes'
                file: '{bashmenu_dir}/bashmenu.themes'
                interactive: true
                quiet: false
                alt_buffer: true
                tabstop: 4
                exec_mode: console
                no_formatting: false
                masked: false
                refresh: false
                stream: false
                show_whitespace: false
                external: false
            - Editor Tab to Spaces Mode [{settings.tab_to_spaces}]:
                type: toggle
                icon: '{nf::#ec3c}'
                prompt: 'Convert TAB key to spaces? (true/false):'
                title: Configure Tab Mode
                key: settings.tab_to_spaces
            - Editor Tabstop Distance [{settings.tabstop}]:
                type: config
                icon: '{nf::#ee10}'
                prompt: 'Enter tabstop distance (spaces per TAB press):'
                title: Configure Tabstop Distance
                key: settings.tabstop
            - Enable Automatic Updates (git pull) [{settings.check_for_updates}]:
                type: toggle
                icon: '{nf::#ea77}'
                message: Enable automatic updates?
                title: Toggle Auto Update
                key: settings.check_for_updates
            - Enable Nerd Fonts [{settings.use_nerd_fonts}]:
                type: toggle
                icon: '{nf::#f031}'
                title: Toggle Nerd Fonts
                key: settings.use_nerd_fonts
                message: Enable colorful menu emojis and Nerd Fonts?
            - Help Gutter Hover Delay [[{app.settings.help_gutter_delay}] seconds]:
                type: config
                icon: '{nf::#f05a}'
                prompt: 'Seconds of stationary mouse hover to expand help gutter (0 to disable delay):'
                interactive: true
                quiet: false
                alt_buffer: true
                title: Configure Help Gutter Hover Delay
                key: app.settings.help_gutter_delay
            - Linux Framebuffer Support [{settings.framebuffer}]:
                type: radio
                icon: '{nf::#f2db}'
                action: settings.framebuffer
                prompt: 'Configure direct Linux framebuffer (/dev/fb0) rendering:'
                interactive: true
                quiet: false
                alt_buffer: true
                key: settings.framebuffer
                options:
                - label: Auto (Detect /dev/fb0 on Linux console, character wallpaper)
                  value: auto
                - label: Full-Resolution Image (Native pixel wallpaper on /dev/fb0)
                  value: image
                - label: Enabled (Force direct framebuffer character rendering)
                  value: 'true'
                - label: Disabled (Standard terminal TUI rendering)
                  value: 'false'
                title: Linux Framebuffer Support [{settings.framebuffer}]
            - Menu Transition Effect [{settings.transition}]:
                type: radio
                icon: '{nf::#f0d0}'
                action: settings.transition
                prompt: 'Select transition effect when returning to menu:'
                interactive: true
                quiet: false
                alt_buffer: true
                title: Return Transition Effect [{settings.transition}]
                options:
                - label: Instant (Synchronized DEC Mode 2026 buffered redraw)
                  value: instant
                - label: Fade (Brightness ramp reveal)
                  value: fade
                - label: Curtain (Center-out vertical wipe reveal)
                  value: curtain
                - label: Dissolve (Retro Bayer matrix dither dissolve)
                  value: dissolve
                - label: Matrix (Cascading green digital rain)
                  value: matrix
                - label: Slide Left (Horizontal slide wipe right to left)
                  value: slide_left
                - label: Slide Right (Horizontal slide wipe left to right)
                  value: slide_right
                - label: Blinds (Venetian blinds horizontal slats opening)
                  value: blinds
                - label: Iris (Rectangular box zoom aperture expanding from center)
                  value: iris
                - label: Wipe Down (Vertical top-to-bottom roll wipe)
                  value: wipedown
                - label: None (Standard immediate redraw)
                  value: none
                key: settings.transition
            - Menu Transition Speed [{settings.transition_speed}]:
                type: radio
                icon: '{nf::#f0e7}'
                action: settings.transition_speed
                prompt: 'Select animation speed for screen transitions:'
                interactive: true
                quiet: false
                alt_buffer: true
                key: settings.transition_speed
                options:
                - label: Fast (~60-75ms, snappy 15ms/step)
                  value: fast
                - label: Normal (Recommended, ~100-125ms, 25ms/step)
                  value: normal
                - label: Slow (Deliberate, ~200-250ms, 50ms/step)
                  value: slow
                title: Screen Transition Speed [{settings.transition_speed}]
            - Modal Animation Effect [{settings.modal_animation}]:
                type: radio
                icon: '{nf::#f065}'
                action: settings.modal_animation
                prompt: 'Select animation style for popup modal dialogs:'
                interactive: true
                quiet: false
                alt_buffer: true
                options:
                - label: Zoom (Animated grow from launch point and shrink on close)
                  value: zoom
                - label: None (Instant popup open and close)
                  value: none
                title: Modal Animation Effect [{settings.modal_animation}]
                key: settings.modal_animation
            - Modal Animation Speed [{settings.modal_animation_speed}]:
                type: radio
                icon: '{nf::#f0e7}'
                action: settings.modal_animation_speed
                prompt: 'Select animation speed for popup modal dialogs:'
                interactive: true
                quiet: false
                alt_buffer: true
                options:
                - label: Fast (~36ms, snappy 12ms/step)
                  value: fast
                - label: Normal (~60ms, smooth 20ms/step)
                  value: normal
                - label: Slow (~120ms, deliberate 40ms/step)
                  value: slow
                key: settings.modal_animation_speed
                title: Modal Animation Speed [{settings.modal_animation_speed}]
            - Nerd Font Display Width [{settings.nerd_font_width}]:
                type: config
                icon: '{nf::#f07e}'
                prompt: 'Enter Nerd Font character width mode (auto, 1, 2):'
                key: settings.nerd_font_width
                title: Configure Nerd Font Glyph Width
            - Pager Text Editor [{settings.pager_editor}]:
                type: radio
                icon: '{nf::#f044}'
                action: settings.pager_editor
                prompt: 'Select editor launched when pressing [e] in pager:'
                interactive: true
                quiet: false
                alt_buffer: true
                key: settings.pager_editor
                options:
                - label: Default System Editor ($EDITOR)
                  value: default
                - label: Built-in Editor (BashEdit)
                  value: builtin
                - label: Vim
                  value: vim
                title: Pager Text Editor [{settings.pager_editor}]
            - Status Gutter Refresh Rate [[{app.settings.refresh_interval}] seconds]:
                type: config
                icon: '{nf:@:#f1452}'
                prompt: 'Seconds until next status gutter refresh:'
                interactive: true
                quiet: false
                alt_buffer: true
                key: app.settings.refresh_interval
            - Toast Message Timeout [[{app.settings.toast_timeout}] seconds]:
                type: config
                icon: '{nf::#f0f3}'
                prompt: 'Seconds to display popup toast notifications:'
                interactive: true
                quiet: false
                alt_buffer: true
                title: Configure Toast Message Timeout
                key: app.settings.toast_timeout
            - '{divider}': null
            - Back to Options & Settings:
                type: back
                icon: '{nf::#f048}'
            - '{divider}': null
      - Edit autoexec.sh [{home}/autoexec.sh]:
          type: editor
          icon: '{nf::#f11e7}'
          action: '{home}/autoexec.sh'
      - Edit .bashrc [{bashrc}]:
          type: editor
          icon: '{nf::#f11e7}'
          action: '{bashrc}'
          show_whitespace: true
      - Edit .bash_aliases [{bash_aliases}]:
          type: editor
          icon: '{nf::#f11e7}'
          action: '{bash_aliases}'
          show_whitespace: true
      - Edit .vimrc [{vimrc}]:
          type: editor
          icon: '{nf::#f11e7}'
          action: '{vimrc}'
          tabstop: 4
      - Edit Grub Configuration:
          type: command
          icon: '{nf::#f11e7}'
          command: sudo nano /etc/default/grub
          action: sudo nano /etc/default/grub
          interactive: true
          quiet: true
          alt_buffer: true
          tabstop: 4
          refresh: false
          masked: false
          exec_mode: console
          no_formatting: false
          show_whitespace: false
          external: false
          stream: false
      - Update Grub:
          type: command
          icon: '{nf::#f11e7}'
          command: sudo update-grub
          action: sudo update-grub
          interactive: false
          quiet: true
          tabstop: 4
          window_percent: 65
          exec_mode: streaming
          external: false
          masked: false
          stream: true
          refresh: false
          no_formatting: false
          show_whitespace: false
      - '{divider}': null
      - Back to Main Menu:
          type: back
          icon: '{nf::#f048}'
      - '{divider}': null
- System Information:
    type: submenu
    icon: '{nf::#e66a:}'
    interactive: true
    quiet: false
    alt_buffer: true
    submenu:
      title: System Information Options
      items:
      - '{divider}': null
      - Check Disk Usage [df -h]:
          type: command
          icon: '{nf::#f02ca:}'
          action: df -h 2>/dev/null
          interactive: false
          quiet: false
          stream: true
      - Check RAM Usage [free -h]:
