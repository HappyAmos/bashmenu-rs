  marquee:
    char: •
    gap: 4
  indicator: "{nf:^:#f06aa:}"
  default_icon: "{nf:>:#f105}"
  window:
    border_horizontal: ─
    border_vertical: │
    border_top_left: ╭
    border_top_right: ╮
    border_bottom_left: ╰
    border_bottom_right: ╯
    left_tee: ├
    right_tee: ┤
    top_tee: ┬
    bottom_tee: ┴
    title_left_cap: "["
    title_right_cap: "]"
    gutter_border: ─
    gutter_separator: │
    gutter_left_tee: ├
    gutter_right_tee: ┤
    gutter_top_tee: ┬
    gutter_bottom_tee: ┴
  divider:
    char: ─
    length: "{window_width}"
